# Local dev env for docker-compose.dev.yml. All passwords are throwaway.

# Run the Django dev server (runserver + DEBUG) so static is served locally.
TETHYS_DEV_SERVER=true

# Minimal local portal: skip the store/service/static init steps. runserver
# serves static via the staticfiles finders; app persistent stores are not
# synced (fine for a static/UI dev loop).
POSTGIS_SERVICE_NAME=
RUN_STORE_SETUP=false
RUN_STATIC=false
PORT=8000

# --- bootstrap-database.sh (creates the app role + tethys_platform, as admin) ---
DB_HOST=db
DB_PORT=5432
ADMIN_USER=tethys_super
APP_USER=tethys_default
APP_PASSWORD=pass
PGPASSWORD=pass

# --- init-tethys.sh / portal-config.sh (app connection) ---
TETHYS_DB_HOST=db
TETHYS_DB_PORT=5432
TETHYS_DB_NAME=tethys_platform
TETHYS_DB_USERNAME=tethys_default
TETHYS_DB_PASSWORD=pass
TETHYS_DB_SUPERUSER=tethys_super
TETHYS_DB_SUPERUSER_PASS=pass

# Django secret key (dev only — throwaway).
TETHYS_SECRET_KEY=dev-insecure-secret-key-do-not-use-in-prod

# --- portal superuser + basics ---
PORTAL_SUPERUSER_NAME=admin
PORTAL_SUPERUSER_PASSWORD=pass
PORTAL_SUPERUSER_EMAIL=admin@example.com
ENABLE_OPEN_PORTAL=true
BYPASS_TETHYS_HOME_PAGE=true
