{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::ciroh-portal-assets/fimeval/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::ciroh-portal-assets",
      "Condition": {
        "StringLike": {
          "s3:prefix": "fimeval/*"
        }
      }
    }
  ]
}
